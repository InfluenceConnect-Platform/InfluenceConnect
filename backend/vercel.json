{
  "version": 2,
  "builds": [{ "src": "index.js", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "index.js" }],
  "crons": [
    { "path": "/api/payments/reconcile", "schedule": "0 3 * * *" },
    { "path": "/api/payments/autopay-renewals", "schedule": "0 2 * * *" },
    { "path": "/api/auth/account/purge-deletions", "schedule": "0 4 * * *" }
  ]
}
